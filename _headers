/*
  Content-Language: en-US
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; manifest-src 'self'; frame-src 'none'; worker-src 'none'; form-action 'none'; upgrade-insecure-requests
  Permissions-Policy: autoplay=(self), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Content-Type: audio/mp4
  Cache-Control: public, max-age=31536000, immutable

/og.jpg
  Cache-Control: public, max-age=86400

/og.gif
  Cache-Control: public, max-age=86400

/share.jpg
  Cache-Control: public, max-age=86400

/card.jpg
  Cache-Control: public, max-age=86400

/card2.jpg
  Cache-Control: public, max-age=86400

/card.gif
  Cache-Control: public, max-age=86400

/card3.gif
  Cache-Control: public, max-age=86400

/card3.jpg
  Cache-Control: public, max-age=86400

/card4.gif
  Cache-Control: public, max-age=86400

/wide.jpg
  Cache-Control: public, max-age=86400

/favicon.gif
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
