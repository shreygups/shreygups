/og.jpg
  Cache-Control: public, max-age=86400

/og.gif
  Cache-Control: public, max-age=86400

/share.jpg
  Cache-Control: public, max-age=86400

/card.jpg
  Cache-Control: public, max-age=86400

/card2.jpg
  Cache-Control: public, max-age=86400

/card.gif
  Cache-Control: public, max-age=86400

/card3.gif
  Cache-Control: public, max-age=86400

/card3.jpg
  Cache-Control: public, max-age=86400

/card4.gif
  Cache-Control: public, max-age=86400

/wide.jpg
  Cache-Control: public, max-age=86400

/favicon.gif
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
